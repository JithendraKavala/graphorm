directive @auth(roles: [String!]!) on FIELD_DEFINITION

type Department {
  id: ID!
  name: String!
  code: String!
  students(limit: Int, offset: Int): [Student!]!
  courses(limit: Int, offset: Int): [Course!]!
  instructors: [Instructor!]!
}

type Instructor {
  id: ID!
  name: String!
  email: String!
  salary: Float @auth(roles: ["ADMIN"])
  departmentId: Int!
  department: Department
  courses(limit: Int, offset: Int): [Course!]!
}

type Student {
  id: ID!
  name: String!
  email: String!
  gpa: Float @auth(roles: ["ADMIN", "INSTRUCTOR"])
  version: Int!
  departmentId: Int
  department: Department
  enrollments(limit: Int, offset: Int): [Enrollment!]!
}

type Course {
  id: ID!
  title: String!
  code: String!
  credits: Int!
  departmentId: Int!
  department: Department
  instructorId: Int
  instructor: Instructor
  enrollments(limit: Int, offset: Int): [Enrollment!]!
}

type Enrollment {
  id: ID!
  studentId: Int!
  student: Student
  courseId: Int!
  course: Course
  grade: String @auth(roles: ["ADMIN", "INSTRUCTOR"])
  gradePoints: Float
  enrollmentDate: String!
}

type GradeScale {
  id: ID!
  letter: String!
  minScore: Float!
  gpaPoint: Float!
}

type AuditLog {
  id: ID!
  action: String!
  details: String
  tenantId: String!
  performedBy: String!
}

type AuditSummary {
  id: ID!
  action: String!
  tenantId: String!
  performedBy: String!
}

type DepartmentStats {
  id: ID!
  departmentName: String!
  studentCount: Int!
  courseCount: Int!
}

type StudentDashboard {
  studentId: Int!
  studentName: String!
  departmentName: String
  enrolledCourses: Int!
  avgGradePoints: Float
}

# --- Relay-Specification Cursor Pagination Types ---

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type StudentEdge {
  cursor: String!
  node: Student!
}

type StudentConnection {
  edges: [StudentEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type CourseEdge {
  cursor: String!
  node: Course!
}

type CourseConnection {
  edges: [CourseEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type DepartmentEdge {
  cursor: String!
  node: Department!
}

type DepartmentConnection {
  edges: [DepartmentEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type StudentDashboardEdge {
  cursor: String!
  node: StudentDashboard!
}

type StudentDashboardConnection {
  edges: [StudentDashboardEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type DepartmentStatsEdge {
  cursor: String!
  node: DepartmentStats!
}

type DepartmentStatsConnection {
  edges: [DepartmentStatsEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

input StudentInput {
  name: String!
  email: String!
  departmentId: Int
  gpa: Float
}

input CourseInput {
  title: String!
  code: String!
  credits: Int!
  departmentId: Int!
  instructorId: Int
}

input DepartmentInput {
  name: String!
  code: String!
}

input AuditLogInput {
  action: String!
  details: String
}

type Query {
  students(limit: Int, offset: Int): [Student!]!
  studentsCount: Int!
  student(id: ID!): Student
  departments(limit: Int, offset: Int): [Department!]!
  departmentsCount: Int!
  department(id: ID!): Department
  courses(limit: Int, offset: Int): [Course!]!
  coursesCount: Int!
  course(id: ID!): Course
  instructors: [Instructor!]!
  instructorsCount: Int!
  instructor(id: ID!): Instructor
  enrollments(limit: Int, offset: Int): [Enrollment!]!
  enrollmentsCount: Int!
  enrollment(id: ID!): Enrollment
  gradeScales: [GradeScale!]!
  auditLogs: [AuditLog!]!
  auditSummaries: [AuditSummary!]!
  departmentStats: [DepartmentStats!]!
  studentDashboards(limit: Int, offset: Int): [StudentDashboard!]!
  studentDashboardsCount: Int!
  studentDashboard(id: ID!): StudentDashboard

  # Relay Keyset Cursor Connections
  studentsConnection(first: Int, after: String, last: Int, before: String): StudentConnection!
  coursesConnection(first: Int, after: String, last: Int, before: String): CourseConnection!
  departmentsConnection(first: Int, after: String, last: Int, before: String): DepartmentConnection!
  studentDashboardsConnection(first: Int, after: String, last: Int, before: String): StudentDashboardConnection!
  departmentStatsConnection(first: Int, after: String, last: Int, before: String): DepartmentStatsConnection!
}

type Mutation {
  createStudent(input: StudentInput!): Student!
  createCourse(input: CourseInput!): Course!
  createDepartment(input: DepartmentInput!): Department!
  createAuditLog(input: AuditLogInput!): AuditLog!
}

type Subscription {
  studentCreated: Student!
  studentUpdated: Student!
  studentDeleted: ID!
}
