datasource db {
  provider = "postgresql"
  url      = "postgresql://localhost:5432/university_db"
}

generator client {
  provider = "graphorm-client-java"
  package  = "com.graphorm.example.university.generated"
}

model Department {
  id          Int          @id @default(autoincrement())
  name        String       @map("dept_name")
  code        String       @unique
  students    Student[]
  courses     Course[]
  instructors Instructor[]

  @@map("departments")
  @@index([code], name: "idx_departments_code")
}

model Instructor {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  salary       Float?     @auth(roles: ["ADMIN"])
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses      Course[]

  @@map("instructors")
  @@index([departmentId], name: "idx_instructors_department")
}

model Student {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  gpa          Float?       @auth(roles: ["ADMIN", "INSTRUCTOR"])
  version      Int          @default(1) @version
  departmentId Int?         @map("department_id")
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]

  @@map("students")
  @@index([departmentId], name: "idx_students_department")
  @@index([email], name: "idx_students_email")
  @@notify(on: [CREATE, UPDATE, DELETE])
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String
  code         String       @unique
  credits      Int
  departmentId Int          @map("department_id")
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  instructorId Int?         @map("instructor_id")
  instructor   Instructor?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]

  @@map("courses")
  @@index([departmentId], name: "idx_courses_department")
  @@index([instructorId], name: "idx_courses_instructor")
}

model Enrollment {
  id             Int      @id @default(autoincrement())
  studentId      Int      @map("student_id")
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       Int      @map("course_id")
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade          String?  @auth(roles: ["ADMIN", "INSTRUCTOR"])
  gradePoints    Float?   @map("grade_points")
  enrollmentDate String   @map("enrollment_date")

  @@map("enrollments")
  @@unique([studentId, courseId], name: "uk_enrollment_student_course")
  @@index([studentId], name: "idx_enrollments_student")
  @@index([courseId], name: "idx_enrollments_course")
  @@notify(on: [CREATE, UPDATE, DELETE])
}

model GradeScale {
  id       Int    @id @default(autoincrement())
  letter   String @unique
  minScore Float  @map("min_score")
  gpaPoint Float  @map("gpa_point")

  @@map("grade_scales")
  @@readonly
}

model AuditLog {
  id          Int     @id @default(autoincrement())
  action      String
  details     String?
  tenantId    String  @map("tenant_id") @tenantId @injected(from: "tenantId")
  performedBy String  @map("performed_by") @injected(from: "auth.username")

  @@map("audit_logs")
  @@auth(roles: ["ADMIN"])
  @@index([tenantId], name: "idx_audit_logs_tenant")
}

view DepartmentStats {
  id             Int    @id
  departmentName String @map("department_name")
  studentCount   Int    @map("student_count")
  courseCount    Int    @map("course_count")

  @@view
  @@map("v_department_stats")
}

view StudentDashboard @cached(ttl: "60s", tags: ["Student", "Enrollment", "Department"]) {
  studentId       Int     @map("s.id")
  studentName     String  @map("s.name")
  departmentName  String? @map("d.dept_name")
  enrolledCourses Int     @aggregate(count: "e.id")
  avgGradePoints  Float?  @expression("ROUND(AVG(e.grade_points)::numeric, 2)")

  @@from(Student, as: "s")
  @@leftJoin(Department, as: "d", on: "s.departmentId == d.id")
  @@leftJoin(Enrollment, as: "e", on: "s.id == e.studentId")
  @@groupBy(["s.id", "s.name", "d.dept_name"])
}

view AuditSummary {
  id          Int    @map("a.id")
  action      String @map("a.action")
  tenantId    String @map("a.tenant_id")
  performedBy String @map("a.performed_by")

  @@from(AuditLog, as: "a")
  @@auth(roles: ["ADMIN"])
}
