directive @auth(roles: [String!]!) on FIELD_DEFINITION

type Department {
  id: ID!
  name: String!
  code: String!
  students: [Student!]!
  courses: [Course!]!
  instructors: [Instructor!]!
}

type Instructor {
  id: ID!
  name: String!
  email: String!
  salary: Float @auth(roles: ["ADMIN"])
  departmentId: Int!
  department: Department
  courses: [Course!]!
}

type Student {
  id: ID!
  name: String!
  email: String!
  gpa: Float @auth(roles: ["ADMIN", "INSTRUCTOR"])
  version: Int!
  departmentId: Int
  department: Department
  enrollments: [Enrollment!]!
}

type Course {
  id: ID!
  title: String!
  code: String!
  credits: Int!
  departmentId: Int!
  department: Department
  instructorId: Int
  instructor: Instructor
  enrollments: [Enrollment!]!
}

type Enrollment {
  id: ID!
  studentId: Int!
  student: Student
  courseId: Int!
  course: Course
  grade: String @auth(roles: ["ADMIN", "INSTRUCTOR"])
  gradePoints: Float
  enrollmentDate: String!
}

type GradeScale {
  id: ID!
  letter: String!
  minScore: Float!
  gpaPoint: Float!
}

type AuditLog {
  id: ID!
  action: String!
  details: String
  tenantId: String!
  performedBy: String!
}

type DepartmentStats {
  id: ID!
  departmentName: String!
  studentCount: Int!
  courseCount: Int!
}

type StudentDashboard {
  studentId: Int!
  studentName: String!
  departmentName: String
  enrolledCourses: Int!
  avgGradePoints: Float
}

type AuditSummary {
  id: ID!
  action: String!
  tenantId: String!
  performedBy: String!
}

# Relay Specification Pagination Types
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type StudentEdge {
  node: Student!
  cursor: String!
}

type StudentConnection {
  edges: [StudentEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type CourseEdge {
  node: Course!
  cursor: String!
}

type CourseConnection {
  edges: [CourseEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type DepartmentEdge {
  node: Department!
  cursor: String!
}

type DepartmentConnection {
  edges: [DepartmentEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type StudentDashboardEdge {
  node: StudentDashboard!
  cursor: String!
}

type StudentDashboardConnection {
  edges: [StudentDashboardEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type DepartmentStatsEdge {
  node: DepartmentStats!
  cursor: String!
}

type DepartmentStatsConnection {
  edges: [DepartmentStatsEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

input StudentInput {
  name: String!
  email: String!
  departmentId: Int
  gpa: Float
}

input CourseInput {
  title: String!
  code: String!
  credits: Int!
  departmentId: Int!
  instructorId: Int
}

input DepartmentInput {
  name: String!
  code: String!
}

input AuditLogInput {
  action: String!
  details: String
}

type Query {
  students: [Student!]!
  student(id: ID!): Student
  studentsConnection(first: Int, after: String, last: Int, before: String): StudentConnection!
  departments: [Department!]!
  department(id: ID!): Department
  departmentsConnection(first: Int, after: String, last: Int, before: String): DepartmentConnection!
  courses: [Course!]!
  course(id: ID!): Course
  coursesConnection(first: Int, after: String, last: Int, before: String): CourseConnection!
  instructors: [Instructor!]!
  instructor(id: ID!): Instructor
  enrollments: [Enrollment!]!
  enrollment(id: ID!): Enrollment
  gradeScales: [GradeScale!]!
  gradeScale(id: ID!): GradeScale
  auditLogs: [AuditLog!]! @auth(roles: ["ADMIN"])
  auditLog(id: ID!): AuditLog @auth(roles: ["ADMIN"])
  departmentStats: [DepartmentStats!]!
  departmentStatsConnection(first: Int, after: String, last: Int, before: String): DepartmentStatsConnection!
  studentDashboards: [StudentDashboard!]!
  studentDashboard(id: ID!): StudentDashboard
  studentDashboardsConnection(first: Int, after: String, last: Int, before: String): StudentDashboardConnection!
  auditSummaries: [AuditSummary!]! @auth(roles: ["ADMIN"])
  auditSummary(id: ID!): AuditSummary @auth(roles: ["ADMIN"])
}

type Mutation {
  createStudent(input: StudentInput!): Student!
  createCourse(input: CourseInput!): Course!
  createDepartment(input: DepartmentInput!): Department!
  createAuditLog(input: AuditLogInput!): AuditLog! @auth(roles: ["ADMIN"])
}

type Subscription {
  studentCreated: Student!
  studentUpdated(id: ID): Student!
  studentDeleted: ID!
}
